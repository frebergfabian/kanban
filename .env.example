OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
PORT=3000
# HOST=0.0.0.0 enables access from your LAN. Default: 127.0.0.1.
HOST=127.0.0.1
# DATABASE_PATH=./data/kanban.sqlite
# OLLAMA_TIMEOUT_MS=120000
# Optional absolute path; default: calendar.key alongside DATABASE_PATH.
# Back up this key securely alongside the database; never commit it.
# CALENDAR_KEY_PATH=/secure/path/calendar.key

# Shared Microsoft 365 Web app. Delegate Mail.Read, Calendars.Read and User.Read.
# Register the exact HTTPS callback in Entra; never commit real credentials.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=
